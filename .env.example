# ============================================
# LIFESYNC AI - Variables de Entorno
# Copiá este archivo como .env.local y completá los valores
# En Vercel: Settings → Environment Variables
# ============================================

# ── Supabase ────────────────────────────────
# https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui  # NUNCA la expongas en el cliente

# ── Google Gemini (Chat IA) ─────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── MercadoPago ─────────────────────────────
# https://www.mercadopago.com.ar/developers/panel
# Credenciales de PRUEBA para desarrollo (empiezan con TEST-)
# Credenciales de PRODUCCIÓN para deploy (empiezan con APP_USR-)
MERCADO_PAGO_ACCESS_TOKEN=TEST-tu_access_token_aqui
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-tu_public_key_aqui
MP_PLAN_PRICE=4999

# ── App ─────────────────────────────────────
# En local: http://localhost:3000
# En Vercel: https://tuapp.vercel.app (o tu dominio custom)
# IMPORTANTE: Para probar MercadoPago en local, usá ngrok o localtunnel
#   npx localtunnel --port 3000  →  actualiza esta variable con la URL que te da
NEXT_PUBLIC_APP_URL=https://busy-beers-cut.loca.lt
